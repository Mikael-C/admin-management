// Real Estate Admin System - Prisma Schema
// PostgreSQL database for Render deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================
// USER AUTHENTICATION & ROLES
// ===========================
model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String   @default("admin") // "super_admin" | "admin" | "landlord" | "agent"
  phone       String?
  avatar      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  landlordProfile   Landlord?  @relation("UserLandlord")
  agentProfile      Agent?     @relation("UserAgent")
  adminProfile      AdminStaff? @relation("UserAdmin")

  // Messages
  sentMessages      Message[]  @relation("SentMessages")
  receivedMessages  Message[]  @relation("ReceivedMessages")

  // Payout requests (as landlord)
  payoutRequests    PayoutRequest[]

  // Activities
  activityLogs      ActivityLog[]

  // Newsletters sent
  newslettersSent   Newsletter[]

  // Invoices & Receipts
  invoicesReceived  Invoice[]  @relation("InvoiceRecipient")
  invoicesCreated   Invoice[]  @relation("InvoiceCreator")

  @@map("users")
}

// ===========================
// ADMIN STAFF (Company Staff)
// ===========================
model AdminStaff {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  department  String?
  position    String?
  staffId     String?  @unique
  bankName    String?
  accountNumber String?
  accountName String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("UserAdmin", fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_staff")
}

// ===========================
// LANDLORDS
// ===========================
model Landlord {
  id          Int      @id @default(autoincrement())
  userId      Int?     @unique
  name        String
  phone       String?
  email       String?
  address     String?
  bankName    String?
  accountNumber String?
  accountName String?
  nin         String?  // National ID
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation("UserLandlord", fields: [userId], references: [id])
  properties  Property[]
  payoutRequests PayoutRequest[]
  invoices    Invoice[]

  @@map("landlords")
}

// ===========================
// AGENTS
// ===========================
model Agent {
  id          Int      @id @default(autoincrement())
  userId      Int?     @unique
  name        String
  phone       String?
  email       String?
  address     String?
  bankName    String?
  accountNumber String?
  accountName String?
  bio         String?
  licenseNo   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation("UserAgent", fields: [userId], references: [id])
  properties  Property[] @relation("AgentProperties")
  maintenanceRequests MaintenanceRequest[]

  @@map("agents")
}

// ===========================
// PROPERTIES
// ===========================
model Property {
  id            Int       @id @default(autoincrement())
  landlordId    Int
  agentId       Int?
  name          String?
  address       String?
  city          String?
  state         String?
  type          String?   @default("Residential") // Residential, Commercial, Rooms
  status        String?   @default("Active")       // Active, Vacant, Needs Repair
  managementFee Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  landlord      Landlord  @relation(fields: [landlordId], references: [id])
  agent         Agent?    @relation("AgentProperties", fields: [agentId], references: [id])
  tenants       Tenant[]
  rents         Rent[]
  expenses      Expense[]
  maintenanceRequests MaintenanceRequest[]
  invoices      Invoice[]

  @@map("properties")
}

// ===========================
// TENANTS
// ===========================
model Tenant {
  id              Int       @id @default(autoincrement())
  propertyId      Int
  name            String
  phone           String?
  email           String?
  rentAmount      Float?
  accommodation   String?
  lastPaymentDate String?
  nextDueDate     String?
  status          String?   @default("Current") // Current, Overdue, Vacated
  vacatedDate     String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property        Property  @relation(fields: [propertyId], references: [id])
  rents           Rent[]

  @@map("tenants")
}

// ===========================
// RENT PAYMENTS
// ===========================
model Rent {
  id            Int       @id @default(autoincrement())
  propertyId    Int?
  tenantId      Int?
  receiptNo     String?
  amountPaid    Float?
  paymentDate   String?
  paymentMethod String?
  debit         Float?    @default(0)
  credit        Float?    @default(0)
  balance       Float?    @default(0)
  period        String?
  createdAt     DateTime  @default(now())

  property      Property? @relation(fields: [propertyId], references: [id])
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  @@map("rents")
}

// ===========================
// EXPENSES
// ===========================
model Expense {
  id            Int       @id @default(autoincrement())
  propertyId    Int?
  description   String?
  debit         Float?
  period        String?
  credit        Float?    @default(0)
  debitBalance  Float?
  creditBalance Float?
  balance       Float?
  receiptNo     String?
  category      String?
  createdAt     DateTime  @default(now())

  property      Property? @relation(fields: [propertyId], references: [id])

  @@map("expenses")
}

// ===========================
// MAINTENANCE / REPAIRS
// ===========================
model MaintenanceRequest {
  id              Int       @id @default(autoincrement())
  propertyId      Int?
  agentId         Int?
  requestedByName String?
  title           String
  description     String?
  category        String?   @default("General") // Plumbing, Electrical, Structural, Painting, HVAC, General
  priority        String?   @default("Medium")  // Low, Medium, High, Emergency
  status          String?   @default("Needs Repair") // Needs Repair, In Progress, Repaired
  estimatedCost   Float?
  actualCost      Float?
  reportedDate    DateTime  @default(now())
  repairedDate    DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property        Property? @relation(fields: [propertyId], references: [id])
  agent           Agent?    @relation(fields: [agentId], references: [id])

  @@map("maintenance_requests")
}

// ===========================
// IN-APP MESSAGING
// ===========================
model Message {
  id          Int       @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  subject     String?
  content     String
  isRead      Boolean   @default(false)
  parentId    Int?      // For reply threading
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  parent      Message?  @relation("MessageReplies", fields: [parentId], references: [id])
  replies     Message[] @relation("MessageReplies")

  @@map("messages")
}

// ===========================
// PAYOUT REQUESTS
// ===========================
model PayoutRequest {
  id              Int       @id @default(autoincrement())
  landlordId      Int
  userId          Int
  amount          Float
  description     String?
  status          String    @default("Pending") // Pending, Approved, Disbursed, Rejected
  bankName        String?
  accountNumber   String?
  accountName     String?
  adminNote       String?
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  disbursedAt     DateTime?
  approvedBy      Int?
  disbursedBy     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  landlord        Landlord  @relation(fields: [landlordId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@map("payout_requests")
}

// ===========================
// LEDGER ENTRIES
// ===========================
model LedgerEntry {
  id          Int      @id @default(autoincrement())
  date        String?
  receiptNo   String?
  particulars String?
  period      String?
  debit       Float?
  credit      Float?
  balance     Float?
  ledgerType  String?  @default("Ledger") // "Ledger" or "CompleteLedger"
  createdAt   DateTime @default(now())

  @@map("ledger_entries")
}

// ===========================
// ACTIVITY LOGS
// ===========================
model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  userName    String
  userRole    String
  action      String   // e.g. "CREATE_PROPERTY", "APPROVE_PAYOUT", "LOG_PAYMENT", etc.
  description String
  entityType  String?  // e.g. "Payout", "Rent", "Property", "Invoice", "Message"
  entityId    Int?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// ===========================
// NEWSLETTERS
// ===========================
model Newsletter {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  targetRole  String   @default("all") // "all" | "landlord" | "agent"
  senderId    Int
  senderName  String
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  sender      User     @relation(fields: [senderId], references: [id])

  @@map("newsletters")
}

// ===========================
// INVOICES & RECEIPTS
// ===========================
model Invoice {
  id             Int       @id @default(autoincrement())
  invoiceNo      String    @unique
  type           String    @default("Invoice") // "Invoice" | "Receipt"
  recipientType  String    @default("landlord") // "landlord" | "agent" | "admin"
  recipientName  String
  recipientEmail String?
  recipientPhone String?
  userId         Int?
  landlordId     Int?
  propertyId     Int?
  amount         Float
  description    String?
  items          String?   // JSON itemized list string
  status         String    @default("Pending") // "Pending" | "Paid" | "Overdue" | "Cancelled"
  issueDate      String
  dueDate        String?
  paidDate       String?
  bankName       String?
  accountNumber  String?
  accountName    String?
  notes          String?
  imageUrl       String?   // URL path to the receipt image file (for visual display)
  createdById    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User?     @relation("InvoiceRecipient", fields: [userId], references: [id], onDelete: SetNull)
  landlord       Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdBy      User      @relation("InvoiceCreator", fields: [createdById], references: [id])

  @@map("invoices")
}
